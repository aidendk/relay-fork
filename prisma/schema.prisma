// schema.prisma
datasource db {
  provider = "postgresql"
  url       = env("POSTGRES_URL")
  // Migrations need a direct (non-pooled) connection; advisory locks hang behind the pooler
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  phone      String?
  carrier    String?
  role       Role        @default(ENGINEER)
  password   String?
  subteam    String      @default("Unassigned")
  orders     Order[]     @relation("UserOrders")
  pushTokens PushToken[] @relation("UserPushTokens")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum Role {
  ENGINEER
  FINANCE
  OPERATIONS
  BUSINESS
}

model Order {
  id               Int         @id @default(autoincrement())
  internalOrderId  String      @unique
  meenOrderId      String? // Nullable until assigned
  name             String
  user             User        @relation("UserOrders", fields: [userId], references: [id])
  userId           Int
  subteam          String
  status           OrderStatus
  vendor           String
  totalCost        Float       @default(0.0)
  costVerified     Boolean     @default(false)
  comments         String?
  url              String?
  carrier          String?
  trackingId       String?
  gmailMessageId   String?     @unique
  costBreakdown    Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            Item[]      @relation("OrderItems")
  supportingDocs   Document[]  @relation("SupportingDocs")
  receipts         Document[]  @relation("Receipts")
  notified         Boolean     @default(false)
  deliveryLocation String?
  deliveryPhotoUrl String?
  // Car the order is for, e.g. "AME27" (season runs June–May). The app always sets it;
  // the DB default (current season, UTC) only backs up inserts that don't.
  // Text matches Postgres's normalized form so Prisma sees no drift.
  carYear          String      @default(dbgenerated("('AME'::text || (((EXTRACT(year FROM timezone('UTC'::text, now())))::integer % 100) +\nCASE\n    WHEN (EXTRACT(month FROM timezone('UTC'::text, now())) >= (6)::numeric) THEN 1\n    ELSE 0\nEND))"))
  trouble          Boolean     @default(false) // Flagged: no update in a long time

  @@index([carYear])
}

enum OrderStatus {
  TO_ORDER
  PLACED
  MEEN_HOLD
  PROCESSED
  SHIPPED
  AWAITING_PICKUP
  PARTIAL
  DELIVERED
  ARCHIVED
  AWAITING_APPROVAL
  AWAITING_RAVI_APPROVAL
  HOLD
  MEEN_RECEIVED
  MEEN_PLACED
  SUPPLIER_SHIPPED
  EV_AWAITING_PICKUP
  PARTIAL_DELIVERY
  MEEN_DELIVERED
  EV_ARCHIVED
}

model Item {
  id               Int         @id @default(autoincrement())
  internalItemId   String      @unique
  internalSKU      String?
  order            Order?      @relation("OrderItems", fields: [orderId], references: [id], onDelete: Cascade)
  orderId          Int?
  name             String
  partNumber       String?
  notes            String?
  quantity         Int?
  price            Float?      @default(0.0)
  priceVerified    Boolean?    @default(false)
  vendor           String?
  vendorSKU        String?
  link             String?
  status           ItemStatus
  location         String?
  level            StockLevel?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deliveryPhotoUrl String?
}

enum ItemStatus {
  TO_ORDER
  PLACED
  PROCESSED
  SHIPPED
  DELIVERED
  PICKED_UP
}

enum StockLevel {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model Document {
  id                Int      @id @default(autoincrement())
  url               String
  supportingOrder   Order?   @relation("SupportingDocs", fields: [supportingOrderId], references: [id], onDelete: Cascade)
  supportingOrderId Int?
  receiptOrder      Order?   @relation("Receipts", fields: [receiptOrderId], references: [id], onDelete: Cascade)
  receiptOrderId    Int?
  uploadedAt        DateTime @default(now())
}

model Token {
  id  Int    @id @default(autoincrement())
  url String
}

model PushToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  platform  String // "ios", "android", or "expo"
  deviceId  String? // Optional device identifier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

model GmailSync {
  id            Int       @id @default(autoincrement())
  lastHistoryId String?
  lastSyncAt    DateTime?
  lastStatus    String    @default("pending")
  lastError     String?
}
